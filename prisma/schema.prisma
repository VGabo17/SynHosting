generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ServiceType {
  MINECRAFT
  DISCORD_BOT
  TELEGRAM_BOT
}

enum PlanTier {
  BUDGET
  PREMIUM
}

enum ServiceStatus {
  PROVISIONING
  RUNNING
  STOPPED
  SUSPENDED
  DELETED
}

enum NodeStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  role         Role      @default(USER)
  image        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  services Service[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Plan {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  type        ServiceType
  tier        PlanTier    @default(BUDGET)
  description String
  priceCents  Int
  cpuCores    Float
  ramMb       Int
  diskMb      Int
  maxPlayers  Int?
  features    String[]
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  services Service[]
}

model Node {
  id       String     @id @default(cuid())
  name     String     @unique
  hostname String
  region   String
  cpuCores Int
  ramMb    Int
  diskMb   Int
  status   NodeStatus @default(ONLINE)

  services Service[]
}

model Service {
  id     String        @id @default(cuid())
  name   String
  type   ServiceType
  status ServiceStatus @default(PROVISIONING)

  userId String
  planId String
  nodeId String?

  // Filled in once the container orchestration layer is wired up.
  containerId String?
  ipAddress   String?
  port        Int?

  config    Json     @default("{}")
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan   Plan           @relation(fields: [planId], references: [id])
  node   Node?          @relation(fields: [nodeId], references: [id])
  events ServiceEvent[]

  @@index([userId])
  @@index([type])
}

model ServiceEvent {
  id        String   @id @default(cuid())
  serviceId String
  message   String
  actor     String?
  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}
